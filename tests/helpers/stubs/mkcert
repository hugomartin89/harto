#!/usr/bin/env bash
[ -n "${HARTO_STUB_LOG:-}" ] && printf 'mkcert %s\n' "$*" >> "$HARTO_STUB_LOG"
cert=""
key=""
if [ "${1:-}" = "-install" ]; then
  exit 0
fi
while [ $# -gt 0 ]; do
  case "$1" in
    -cert-file)
      cert="$2"
      shift 2
      ;;
    -key-file)
      key="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done
if [ -n "$cert" ]; then
  printf 'certificate\n' > "$cert"
  printf 'key\n' > "$key"
fi
exit 0
