<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>harto.devhost.dnsmasq</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DNSMASQ__</string>
    <string>--keep-in-foreground</string>
    <string>--conf-file=__CONF__</string>
  </array>
  <key>RunAtLoad</key>
  <__RUN_AT_LOAD__/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/dnsmasq.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/dnsmasq.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/var/root</string>
    <key>XDG_CONFIG_HOME</key>
    <string>/var/root/.config</string>
    <key>XDG_DATA_HOME</key>
    <string>/var/root/.local/share</string>
  </dict>
</dict>
</plist>
